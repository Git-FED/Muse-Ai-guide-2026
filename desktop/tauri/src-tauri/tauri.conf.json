{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FedPromptly Muse Audit",
  "version": "1.0.0",
  "identifier": "com.fedpromptly.museaudit.tauri",
  "build": {
    "frontendDist": "../../../site",
    "devUrl": "https://muse.ai/"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "FedPromptly Muse Audit",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'",
      "capabilities": ["default"]
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 FedPromptly",
    "category": "Productivity",
    "shortDescription": "A local-first Muse usage audit companion.",
    "longDescription": "A local-first desktop wrapper for the FedPromptly Muse Audit static guide and ledger.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
